{
  "name": "osu!idle Analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Get useful insights from different aspects of the game to optimize your progression.",
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "format": "oxfmt",
    "lint": "oxlint",
    "spellcheck": "cspell --config cspell.json --no-progress --no-summary --no-show-suggestions --no-must-find-files  --gitignore ./"
  },
  "dependencies": {
    "@fontsource/geist-sans": "5.3.0",
    "tailwindcss": "4.3.3",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@cspell/dict-fr-fr": "2.3.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.2.2",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "cspell": "10.0.1",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vite-plugin-zip-pack": "1.2.4",
    "vue-tsc": "3.3.7"
  }
}
