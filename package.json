{
  "name": "osu!idle Analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Get useful insights from different aspects of the game to optimize your progression.",
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "format": "oxfmt",
    "lint": "oxlint",
    "spellcheck": "cspell --config cspell.json --no-progress --no-summary --no-show-suggestions --no-must-find-files  --gitignore ./"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@tailwindcss/vite": "^4.3.1",
    "tailwindcss": "4.1.18",
    "vue": "3.5.30"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@cspell/dict-fr-fr": "2.3.2",
    "@types/chrome": "0.2.0",
    "@types/node": "26.0.1",
    "@vitejs/plugin-vue": "6.0.5",
    "@vue/tsconfig": "0.9.0",
    "cspell": "9.6.2",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "~5.9.3",
    "vite-plugin-zip-pack": "1.2.4",
    "vite": "8.0.0",
    "vue-tsc": "3.2.5"
  }
}
